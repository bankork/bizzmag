# ----------------------------------------------------------------------------
# Salon Operations Platform: backend environment
#
# Copy to .env and fill in. Values below are for local development.
# Production values and notes: docs/runbooks/deploy-cpanel.md, deploy-vps.md.
# Never commit a real .env file.
# ----------------------------------------------------------------------------

APP_NAME="Salon Operations"
# local | staging | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# Must be false in production (app:preflight fails otherwise)
APP_DEBUG=true
# The API's own URL. Production: https://api.your-domain
APP_URL=http://localhost:8000
# Timestamps are always stored in UTC (fixed in config/app.php).
# The salon's timezone (Africa/Lagos) is a business setting, not an env value.
# Release label shown by /api/v1/meta. Set by the deploy script.
APP_VERSION=dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Web app origin (CORS, cookie login, links in emails)
# Production: https://app.your-domain (cPanel, VPS or a Vercel custom domain).
# A *.vercel.app address cannot log in; see docs/runbooks/deploy-vercel.md.
# Several origins may be comma-separated.
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Host (and port) of the web app. Production: app.your-domain
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ----------------------------------------------------------------------------
# Database: MySQL 8.0.16+ or MariaDB 10.6+ (SQLite is not supported)
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bizzmag_dev
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------------------------
# Sessions. When the web app and API are on different subdomains, set
# SESSION_DOMAIN to the shared parent with a leading dot, e.g. .your-domain
# Production: SESSION_SECURE_COOKIE=true, SESSION_SAME_SITE=lax
# Locally (API on localhost:8000, web app on localhost:3000) keep null:
# browsers share cookies between ports of the same host.
# SESSION_LIFETIME (minutes) must cover the longest idle limit in
# Settings: 10080 = 7 days. Shorter limits are enforced by the app itself.
# Disabling a user signs them out everywhere only with the database driver.
# ----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----------------------------------------------------------------------------
# Queue and scheduler. One cron entry runs `php artisan schedule:run` every
# minute. On cPanel the scheduler also runs the queue worker. On a VPS with
# a supervised worker (systemd), set QUEUE_WORK_VIA_SCHEDULER=false.
# ----------------------------------------------------------------------------
QUEUE_CONNECTION=database
QUEUE_WORK_VIA_SCHEDULER=true
# Optional: an uptime monitor URL pinged every five minutes
HEARTBEAT_URL=

CACHE_STORE=database
# CACHE_PREFIX=

# ----------------------------------------------------------------------------
# Logs. Production: LOG_STACK=daily, LOG_LEVEL=warning
# ----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Mail (receipts and invoices by email, Phase 5). Use your host's SMTP.
# ----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Off-site backups (Phase 6): any S3-compatible bucket, for example
# Backblaze B2 or Cloudflare R2.
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_ARCHIVE_PASSWORD=

IDEMPOTENCY_RETENTION_DAYS=7
BUSINESS_DEFAULT_TIMEZONE=Africa/Lagos
